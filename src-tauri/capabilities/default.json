{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the two Glitch windows may do. App commands (chat, settings, ...) are defined in src-tauri/src/commands.rs.",
  "windows": ["mascot", "panel"],
  "permissions": [
    "core:default",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus"
  ]
}
