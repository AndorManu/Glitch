    "allow-update-status",
    "allow-update-check",
    "allow-update-set-auto",
    "allow-update-install",
    "allow-safety-status",
    "allow-safety-set-paused",
    "allow-safety-set-hotkey",
    "allow-safety-set-autostart",
    "allow-undo-last-action",
    "allow-undo-status"
